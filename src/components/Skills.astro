---
import { skillGroups, tools } from '../data/skills';
---

<section class="section skills" id="skills">
  <div class="container">
    <div class="section-head reveal">
      <div><div class="kicker">Skills</div><h2>What I work with.</h2></div>
      <p>Grouped by layer. Bold means I use it every week; the rest I have shipped with but would still open the docs.</p>
    </div>
    <div class="groups">
      {skillGroups.map((g, gi) => (
        <div class="group reveal" data-delay={String(gi % 3 + 1)}>
          <div class="ghead"><span class="num">0{gi + 1}</span><h3>{g.title}</h3></div>
          <p class="desc">{g.description}</p>
          <ul>
            {g.skills.map((s) => <li class:list={['chip', { strong: s.level >= 4 }]}>{s.name}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="tools reveal">
      <span class="label">Also</span>
      {tools.map((t) => <span class="chip faint">{t}</span>)}
    </div>
  </div>
</section>

<style>
  .skills { border-top: 1px solid var(--line); }
  .groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .group { background: color-mix(in srgb, var(--bg) 80%, transparent); padding: 1.75rem; display: grid; gap: 0.75rem; align-content: start; }
  .ghead { display: flex; align-items: baseline; gap: 0.75rem; }
  .num { font-family: var(--mono); color: var(--accent); font-size: 0.8rem; }
  h3 { font-size: 1.5rem; }
  .desc { color: var(--dim); font-size: 0.9rem; }
  ul { list-style: none; padding: 0; margin: 0.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .chip { font-size: 0.85rem; padding: 0.4rem 0.75rem; border-radius: 999px; border: 1px solid var(--line-2); color: var(--muted); }
  .chip.strong { color: var(--text); border-color: color-mix(in srgb, var(--accent) 60%, transparent); background: color-mix(in srgb, var(--accent) 10%, transparent); font-weight: 600; }
  .chip.faint { font-size: 0.78rem; color: var(--dim); }
  .tools { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
  .label { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin-right: 0.5rem; }
  @media (max-width: 760px) { .groups { grid-template-columns: 1fr; } }
</style>
