---
import { skillGroups, tools } from '../data/skills';
---

<section class="section" id="skills">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Skills</div>
      <h2>What I work with.</h2>
      <p class="lead">Grouped by layer. The bars are my own rating, and a 3 means I have shipped with it but would still open the docs.</p>
    </div>

    <div class="groups">
      {skillGroups.map((g) => (
        <article class="card reveal">
          <h3>{g.title}</h3>
          <p class="desc">{g.description}</p>
          <ul class="skill-list">
            {g.skills.map((s) => (
              <li>
                <div class="row">
                  <span>{s.name}</span>
                  <span class="lvl" aria-label={`${s.level} out of 5`}>{s.level}/5</span>
                </div>
                <div class="bar" role="presentation"><span style={`--w:${(s.level / 5) * 100}%`}></span></div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="tools reveal">
      <span class="tools-label">Also fluent with</span>
      <ul>{tools.map((t) => <li class="tag">{t}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .desc { color: var(--text-muted); font-size: 0.95rem; }
  .skill-list { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.7rem; }
  .row { display: flex; justify-content: space-between; font-size: 0.92rem; margin-bottom: 0.3rem; }
  .lvl { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim); }
  .bar { height: 6px; background: var(--border); border-radius: 999px; overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); transition: width 0.9s cubic-bezier(.2,.8,.2,1); }
  :global(.reveal.in) .bar span { width: var(--w); }
  .tools { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .tools-label { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.1em; }
  .tools ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 800px) { .groups { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .bar span { transition: none; width: var(--w); } }
</style>
