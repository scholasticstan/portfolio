---
import { experience, education } from '../data/experience';
---

<section class="section xp" id="experience">
  <div class="container">
    <div class="section-head reveal">
      <div><h2>Where I have worked.</h2></div>
      <p>Most recent first. The ALX entry is there because it is where the systems side of my work comes from.</p>
    </div>

    <ol class="timeline">
      {experience.map((e, i) => (
        <li class="entry reveal" data-delay={String(i % 3 + 1)}>
          <div class="rail" aria-hidden="true"><span class="node"></span></div>
          <article class="card body">
            <header class="head">
              <div class="titles">
                <h3>{e.role}</h3>
                <p class="co">{e.url ? <a href={e.url} target="_blank" rel="noopener">{e.company}</a> : e.company}</p>
              </div>
              <span class="period">{e.period}</span>
            </header>
            <p class="sum">{e.summary}</p>
            <ul class="hl">{e.highlights.map((h) => <li>{h}</li>)}</ul>
          </article>
        </li>
      ))}
    </ol>

    <div class="edu">
      {education.map((ed, i) => (
        <div class="card ecard reveal" data-delay={String(i % 3 + 1)}>
          <span class="eperiod">{ed.period}</span>
          <strong>{ed.title}</strong>
          <span class="detail">{ed.detail}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .xp { border-top: 1px solid var(--line); }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .entry { display: grid; grid-template-columns: 40px 1fr; gap: 1rem; }
  .rail { position: relative; }
  .rail::before { content: ''; position: absolute; left: 50%; top: 0; bottom: -1.25rem; width: 2px; transform: translateX(-50%); background: linear-gradient(180deg, var(--accent), var(--accent-2), transparent); opacity: 0.55; }
  .entry:last-child .rail::before { bottom: 40%; }
  .node { position: absolute; left: 50%; top: 1.9rem; width: 14px; height: 14px; border-radius: 50%; transform: translate(-50%, -50%); background: var(--grad); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent), 0 0 24px var(--glow-a); }
  .body { padding: 1.5rem 1.75rem; display: grid; gap: 0.9rem; transition: transform 0.25s cubic-bezier(.2,.8,.2,1), border-color 0.25s; }
  .body:hover { transform: translateX(4px); border-color: var(--line-2); }
  .head { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem; }
  h3 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); }
  .co { color: var(--muted); font-size: 0.95rem; margin-top: 0.15rem; }
  .co a { color: var(--accent-2); }
  .period { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); border: 1px solid var(--line-2); border-radius: 999px; padding: 0.3rem 0.7rem; white-space: nowrap; }
  .sum { color: var(--text); font-size: 1rem; }
  .hl { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; color: var(--muted); font-size: 0.95rem; }
  .hl li { position: relative; padding-left: 1.2rem; }
  .hl li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-radius: 2px; background: var(--grad); }
  .edu { margin-top: 2rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .ecard { padding: 1.25rem 1.4rem; display: grid; gap: 0.3rem; }
  .eperiod { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-2); }
  .ecard strong { font-family: var(--display); font-size: 1.1rem; }
  .detail { color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 760px) {
    .entry { grid-template-columns: 1fr; }
    .rail { display: none; }
    .head { grid-template-columns: 1fr; }
    .period { justify-self: start; }
    .edu { grid-template-columns: 1fr; }
  }
</style>
