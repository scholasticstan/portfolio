---
// A hand-built replica of the LinkBolt analytics page. Real markup, no screenshot.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const days = [2,0,1,3,1,0,2,4,3,1,2,5,3,2,6,4,3,7,5,4,8,6,9,7,6,10,8,11,9,12];
const max = Math.max(...days);
---

<div class:list={['mock', { compact }]} aria-hidden="true">
  <div class="chrome">
    <span></span><span></span><span></span>
    <div class="url"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> lnk.scholasticstanley.com/dashboard/src</div>
  </div>
  <div class="body">
    <div class="top">
      <span class="slug">/src</span>
      <span class="dest">→ github.com/scholasticstan/linkbolt</span>
    </div>
    <div class="stats">
      <div><b>184</b><i>clicks · 30 days</i></div>
      <div><b>141</b><i>unique visitors</i></div>
      <div><b>23</b><i>bots filtered</i></div>
      <div><b>NG</b><i>top country</i></div>
    </div>
    <div class="chart">
      {days.map((d, i) => <span style={`--h:${(d / max) * 100}%; --i:${i}`}></span>)}
    </div>
    <div class="rows">
      <div><span>linkedin.com</span><em style="--w:58%"></em><small>58%</small></div>
      <div><span>t.co</span><em style="--w:24%"></em><small>24%</small></div>
      <div><span>Direct</span><em style="--w:11%"></em><small>11%</small></div>
    </div>
  </div>
</div>

<style>
  .mock {
    --p: 1.25rem;
    background: color-mix(in srgb, var(--bg-2) 85%, transparent); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border: 1px solid var(--line-2); border-radius: 18px; overflow: hidden;
    box-shadow: 0 50px 120px -40px rgba(0,0,0,0.9), 0 0 0 1px rgba(255,255,255,0.04) inset, 0 0 80px -30px var(--glow-a);
    font-family: var(--sans); font-size: 0.8rem; color: var(--muted);
  }
  .compact { --p: 0.9rem; font-size: 0.72rem; border-radius: 14px; }
  .chrome { display: flex; align-items: center; gap: 6px; padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--line); background: rgba(255,255,255,0.03); }
  .chrome > span { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
  .url { margin-left: 0.5rem; flex: 1; display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 0.7rem; color: var(--dim); background: var(--bg); border-radius: 6px; padding: 0.25rem 0.6rem; }
  .body { padding: var(--p); display: grid; gap: var(--p); }
  .top { display: flex; align-items: baseline; gap: 0.75rem; }
  .slug { font-family: var(--mono); color: var(--accent); font-size: 1.3em; font-weight: 500; }
  .dest { font-family: var(--mono); color: var(--dim); font-size: 0.85em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; }
  .stats div { background: rgba(255,255,255,0.03); border: 1px solid var(--line); border-radius: 10px; padding: 0.6rem 0.75rem; display: grid; }
  .stats b { font-family: var(--display); font-weight: 700; font-size: 1.5em; color: var(--text); letter-spacing: -0.02em; }
  .stats i { font-style: normal; font-size: 0.8em; color: var(--dim); }
  .chart { display: flex; align-items: flex-end; gap: 3px; height: 90px; padding: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid var(--line); border-radius: 10px; }
  .compact .chart { height: 64px; }
  .chart span { flex: 1; height: var(--h); min-height: 3px; background: linear-gradient(180deg, var(--accent-2), var(--accent)); border-radius: 2px 2px 0 0; opacity: 0.9; transform-origin: bottom; transform: scaleY(0); transition: transform 0.6s cubic-bezier(.2,.8,.2,1); transition-delay: calc(var(--i) * 18ms); }
  :global(.in) .chart span, .mock.static .chart span { transform: scaleY(1); }
  .rows { display: grid; gap: 0.45rem; }
  .rows div { display: grid; grid-template-columns: 90px 1fr 36px; align-items: center; gap: 0.6rem; }
  .rows span { color: var(--text); }
  .rows em { height: 5px; border-radius: 99px; background: var(--line); position: relative; overflow: hidden; }
  .rows em::after { content: ''; position: absolute; inset: 0; width: var(--w); background: var(--grad); }
  .rows small { text-align: right; color: var(--dim); font-family: var(--mono); }
  @media (max-width: 560px) { .stats { grid-template-columns: repeat(2, 1fr); } .dest { display: none; } }
</style>
