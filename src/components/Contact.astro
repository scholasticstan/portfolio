---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section contact" id="contact">
  <div class="container">
    <h2 class="reveal" data-delay="1">Hiring?<br />Let's talk<span class="period grad-text">.</span></h2>
    <a class="mail reveal" data-delay="2" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="row reveal" data-delay="3">
      <p>Send the job description, or just the problem you are trying to solve. I reply within a day, and I can do a take-home or a pairing session at short notice.</p>
      <ul class="socials">
        <li><a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" size={26} /></a></li>
        <li><a href={site.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub"><Icon name="github" size={26} /></a></li>
        {site.twitter && <li><a href={site.twitter} target="_blank" rel="noopener" aria-label="X" title="X"><Icon name="x" size={23} /></a></li>}
        <li><a href={site.resume} target="_blank" rel="noopener" aria-label="Download CV" title="CV"><Icon name="cv" size={26} /></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact { border-top: 1px solid var(--line); }
  h2 { font-size: clamp(3.5rem, 12vw, 9rem); letter-spacing: -0.05em; line-height: 0.9; }
  .period { color: var(--accent); }
  .mail { display: inline-block; margin-top: 2rem; font-family: var(--mono); font-size: clamp(1.1rem, 3vw, 2rem); color: var(--text); border-bottom: 2px solid transparent; border-image: var(--grad) 1; padding-bottom: 0.2rem; transition: color 0.15s; }
  .mail:hover { color: var(--accent); }
  .row { margin-top: 2.5rem; display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .row p { color: var(--muted); max-width: 40ch; }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; align-items: center; }
  .socials a { display: inline-flex; color: var(--muted); transition: color 0.15s, transform 0.15s; }
  .socials a:hover { color: var(--accent); transform: translateY(-2px); }
</style>
