---
import { site } from '../data/site';
---

<section class="section" id="contact">
  <div class="container">
    <div class="contact card reveal">
      <div>
        <div class="eyebrow">Contact</div>
        <h2>Let's build something.</h2>
        <p class="lead">
          Have a project, a role, or a hard problem? I'd love to hear about it. I usually reply within a day.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="btn" href={site.resume} target="_blank" rel="noopener">Download CV</a>
        </div>
      </div>
      <ul class="socials">
        <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        {site.github && <li><a href={site.github} target="_blank" rel="noopener">GitHub</a></li>}
        {site.twitter && <li><a href={site.twitter} target="_blank" rel="noopener">Twitter / X</a></li>}
        <li><a href={site.company.url} target="_blank" rel="noopener">{site.company.name}</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact { display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; padding: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .contact:hover { transform: none; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .socials { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .socials a {
    display: flex; justify-content: space-between; padding: 0.9rem 1rem;
    border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-weight: 600;
  }
  .socials a::after { content: '↗'; color: var(--text-dim); }
  .socials a:hover { text-decoration: none; border-color: var(--accent); }
  @media (max-width: 800px) { .contact { grid-template-columns: 1fr; } }
</style>
