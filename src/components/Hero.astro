---
import { site } from '../data/site';
import LinkBoltMock from './LinkBoltMock.astro';
import Icon from './Icon.astro';
const marquee = ['React', 'TypeScript', 'Next.js', 'Node.js', 'PostgreSQL', 'Drizzle', 'Tailwind', 'Astro', 'Vitest', 'GitHub Actions', 'Python', 'Flask', 'MySQL', 'C', 'Linux', 'MongoDB', 'Firebase'];
---

<section class="hero" id="top">
  <div class="container">
    {site.available && <p class="eyebrow enter"><span class="avail"><span class="dot"></span> Available now</span></p>}
    <h1 class="enter" style="--d:0.08s">
      <span class="line">Stanley</span>
      <span class="line">Alu<span class="period grad-text">.</span></span>
    </h1>
    <div class="sub enter" style="--d:0.16s">
      <p>
        Frontend engineer and founder. I ship the whole feature:{' '}
        <em>the interface, the API behind it, the database, the tests.</em>{' '}
        Looking for a frontend or full-stack role. Remote across EMEA, or Nigeria. Available now.
      </p>
      <div class="cta">
        <a class="btn btn-accent" href="/projects/linkbolt/">Read the LinkBolt case study <span class="arrow">→</span></a>
        <a class="btn" href="#contact">Hire me</a>
        <a class="btn" href={site.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>
      </div>
    </div>
  </div>

  <div class="container showcase enter in" style="--d:0.3s">
    <div class="label"><span class="kicker">Latest build</span><p>LinkBolt, a link shortener with analytics that separate people from bots. Next.js, Postgres, 33 tests, CI on every push. Alongside <a href="/projects/payroid/">Payroid</a>, the fintech I founded, and the <a href="/projects/bethadel-media/">Bethadel Media</a> site.</p></div>
    <LinkBoltMock />
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[...marquee, ...marquee].map((m) => <span>{m}</span>)}
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(7rem, 14vw, 11rem) 0 0; }
  .enter { animation: enter 0.8s cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d, 0s); }
  @keyframes enter { from { opacity: 0; transform: translateY(22px); } }
  .eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-family: var(--mono); font-size: 0.8rem; color: var(--muted); margin-bottom: 1.5rem; }
  .eyebrow a { color: var(--text); border-bottom: 1px solid var(--line-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--grad); box-shadow: 0 0 0 0 var(--accent); animation: pulse 2.2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); } 70% { box-shadow: 0 0 0 9px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .avail { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.8rem 0.3rem 0.6rem; border-radius: 999px; background: color-mix(in srgb, var(--accent-2) 12%, transparent); color: var(--accent-2); border: 1px solid color-mix(in srgb, var(--accent-2) 35%, transparent); }

  h1 { font-size: clamp(4.2rem, 15vw, 12.5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.86; display: grid; }
  .line { display: block; }
  .line:nth-child(2) { margin-left: clamp(0.5rem, 12vw, 10rem); }
  .period { color: var(--accent); }
  h1 { text-shadow: 0 30px 80px rgba(124, 98, 255, 0.25); }

  .sub { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: end; margin-top: 2.5rem; }
  .sub p { font-size: clamp(1.15rem, 2vw, 1.5rem); color: var(--muted); line-height: 1.4; max-width: 30ch; }
  .sub em { font-style: normal; color: var(--text); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: end; }

  .showcase { margin-top: clamp(3rem, 6vw, 5rem); display: grid; grid-template-columns: 260px 1fr; gap: 2rem; align-items: end; }
  .label p { color: var(--muted); font-size: 0.95rem; }
  .label a { color: var(--text); border-bottom: 1px solid var(--line-2); }

  .marquee { margin-top: clamp(3rem, 6vw, 5rem); border-block: 1px solid var(--line); overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; gap: 3rem; width: max-content; padding: 1rem 0; animation: scroll 40s linear infinite; }
  .track span { font-family: var(--display); font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; color: var(--dim); white-space: nowrap; }
  .track span:nth-child(3n) { color: var(--muted); }
  .marquee { border-image: linear-gradient(90deg, transparent, var(--line-2), transparent) 1; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  @media (max-width: 900px) {
    .sub { grid-template-columns: 1fr; }
    .cta { justify-content: start; }
    .showcase { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .dot, .track { animation: none; } }
</style>
