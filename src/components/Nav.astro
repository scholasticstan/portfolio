---
import { site, nav } from '../data/site';
---

<header class="wrap">
  <div class="pill">
    <a href="/" class="brand" aria-label="Home">
      <span class="mark">SA</span>
      <span class="name">{site.handle}</span>
    </a>
    <nav aria-label="Primary">
      <ul id="nav-links" class="links">
        {nav.map((item) => <li><a href={item.href} class:list={{ hire: item.label === 'Hire me' }}>{item.label === 'Hire me' && site.available && <span class="live" aria-hidden="true"></span>}{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="right">
      <button class="icon theme-btn" aria-label="Toggle colour theme" title="Toggle theme">
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <button class="icon menu-btn" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const links = document.getElementById('nav-links');
    const pill = document.querySelector<HTMLElement>('.pill');
    // Runs on first load and after every client-side navigation; bind each header only once.
    if (!pill || pill.dataset.bound) return;
    pill.dataset.bound = '1';
    btn?.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      pill?.classList.toggle('open', !open);
    });
    links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      pill?.classList.remove('open');
    }));
    document.querySelector('.theme-btn')?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });
  }
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .wrap { position: fixed; top: 1rem; left: 0; right: 0; z-index: 50; display: flex; justify-content: center; padding-inline: 1rem; pointer-events: none; }
  .pill {
    pointer-events: auto;
    display: flex; align-items: center; gap: 0.5rem;
    background: color-mix(in srgb, var(--bg-2) 60%, transparent);
    backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem 0.5rem 0.4rem 0.6rem;
    box-shadow: 0 10px 40px -20px rgba(0,0,0,0.6);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.9rem; padding-right: 0.5rem; }
  .mark { font-family: var(--display); font-weight: 800; font-size: 0.75rem; background: var(--grad); color: #fff; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; letter-spacing: -0.02em; }
  .links { display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .links a { display: block; padding: 0.45rem 0.85rem; border-radius: 999px; font-size: 0.9rem; color: var(--muted); font-weight: 500; transition: background 0.15s, color 0.15s; }
  .links a:hover { color: var(--text); background: var(--line); }
  .links a.hire { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--text); }
  .live { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); animation: live 2.2s infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55); } 70% { box-shadow: 0 0 0 7px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  @media (prefers-reduced-motion: reduce) { .live { animation: none; } }
  .right { display: flex; gap: 0.25rem; }
  .icon { width: 34px; height: 34px; border-radius: 50%; border: 1px solid transparent; background: none; color: var(--muted); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .icon:hover { color: var(--text); background: var(--line); }
  .theme-btn .moon { display: none; }
  :global(:root[data-theme='light']) .theme-btn .sun { display: none; }
  :global(:root[data-theme='light']) .theme-btn .moon { display: block; }
  .menu-btn { display: none; flex-direction: column; gap: 5px; }
  .menu-btn span { width: 16px; height: 2px; background: currentColor; border-radius: 2px; transition: transform 0.2s; }
  .pill.open .menu-btn span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .pill.open .menu-btn span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  @media (max-width: 760px) {
    .name { display: none; }
    .menu-btn { display: inline-flex; }
    .pill { flex-wrap: wrap; border-radius: 22px; }
    .pill nav { order: 3; width: 100%; display: none; }
    .pill.open nav { display: block; }
    .links { flex-direction: column; padding: 0.5rem 0.25rem 0.25rem; border-top: 1px solid var(--line); margin-top: 0.4rem; }
    .links a { padding: 0.7rem 0.75rem; font-size: 1rem; }
    .brand { margin-right: auto; }
  }
</style>
