---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tags, repo, live, accent, date } = project.data;
const formatted = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---

<Base title={title} description={description}>
  <article class="container project" style={`--pc:${accent}`}>
    <a class="back" href="/#projects">← All projects</a>
    <header class="head">
      <div class="eyebrow">Case study · {formatted}</div>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>
      <div class="cta">
        {live && <a class="btn btn-primary" href={live} target="_blank" rel="noopener">View live ↗</a>}
        {repo && <a class="btn" href={repo} target="_blank" rel="noopener">Source code ↗</a>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .project { padding: 3rem 0 5rem; max-width: 760px; }
  .back { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted); }
  .head { margin: 1.5rem 0 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .head h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .head .eyebrow { color: var(--pc); }
  .head .eyebrow::before { background: var(--pc); }
  .tags { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags .tag { --accent: var(--pc); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .prose { color: var(--text-muted); font-size: 1.05rem; }
  .prose :global(h2) { color: var(--text); font-size: 1.5rem; margin-top: 2.5rem; }
  .prose :global(h3) { color: var(--text); margin-top: 2rem; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; display: grid; gap: 0.4rem; }
  .prose :global(a) { color: var(--pc); }
</style>
