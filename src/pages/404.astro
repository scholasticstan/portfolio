---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="container nf">
    <div class="kicker">404</div>
    <h1>Nothing here<span>.</span></h1>
    <p>That route does not resolve.</p>
    <a class="btn btn-accent" href="/">Back home</a>
  </section>
</Base>
<style>
  .nf { padding: 10rem 0; max-width: 600px; display: grid; gap: 1rem; justify-items: start; }
  h1 { font-size: clamp(3rem, 10vw, 7rem); } h1 span { color: var(--accent); }
  p { color: var(--muted); }
</style>
